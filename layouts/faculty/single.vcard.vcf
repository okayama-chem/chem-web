{{- /* Faculty vCard 3.0 — generated from page front matter */ -}}
{{- $title := .Title -}}
{{- $parts := split $title " " -}}
{{- $family := "" -}}
{{- $given := "" -}}
{{- if eq .Lang "ja" -}}
  {{- $family = index $parts 0 -}}
  {{- range $i, $p := $parts -}}
    {{- if gt $i 0 -}}
      {{- if $given -}}{{ $given = printf "%s %s" $given $p }}{{- else -}}{{ $given = $p }}{{- end -}}
    {{- end -}}
  {{- end -}}
{{- else -}}
  {{- $last := sub (len $parts) 1 -}}
  {{- $family = index $parts $last -}}
  {{- range $i, $p := $parts -}}
    {{- if lt $i $last -}}
      {{- if $given -}}{{ $given = printf "%s %s" $given $p }}{{- else -}}{{ $given = $p }}{{- end -}}
    {{- end -}}
  {{- end -}}
{{- end -}}
BEGIN:VCARD
VERSION:3.0
N:{{ replace (replace (replace $family "\\" "\\\\") ";" "\\;") "," "\\," }};{{ replace (replace (replace $given "\\" "\\\\") ";" "\\;") "," "\\," }};;;
FN:{{ replace (replace (replace $title "\\" "\\\\") ";" "\\;") "," "\\," }}
ORG:{{ replace (replace (replace (i18n "university") "\\" "\\\\") ";" "\\;") "," "\\," }};{{ replace (replace (replace (i18n "department") "\\" "\\\\") ";" "\\;") "," "\\," }}{{ with .Params.laboratory.name }};{{ replace (replace (replace . "\\" "\\\\") ";" "\\;") "," "\\," }}{{ end }}
TITLE:{{ replace (replace (replace .Params.rank "\\" "\\\\") ";" "\\;") "," "\\," }}
{{- with .Params.image }}
PHOTO;VALUE=URI:{{ . | absURL }}
{{- end }}
{{- range .Params.contact }}
{{- if eq .icon "ti-email" }}
EMAIL;TYPE=INTERNET:{{ .name }}
{{- else if eq .icon "ti-mobile" }}
TEL;TYPE=WORK,VOICE:{{ .name }}
{{- else if eq .icon "ti-location-pin" }}
{{- if and .name (ne .name "None") (not (findRE `(?i)\bNone\b` .name)) }}
ADR;TYPE=WORK:;;{{ replace (replace (replace .name "\\" "\\\\") ";" "\\;") "," "\\," }};;;;
{{- end }}
{{- else if eq .icon "ti-world" }}
{{- with .link }}
URL:{{ . }}
{{- end }}
{{- end }}
{{- end }}
END:VCARD
